<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="64dp"
                android:paddingTop="16dp"
                android:paddingEnd="64dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/tvRoomTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المرسل ⇄ المستقبل"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/viewPeerDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        android:id="@+id/tvPeerPresence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="غير متصل"
                        android:textColor="@color/presence_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="جاري الاتصال..."
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="top|right"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_corner_curl" />

            <ImageButton
                android:id="@+id/btnChatSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|left"
                android:layout_margin="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="الإعدادات"
                android:src="@drawable/ic_gear"
                app:tint="@color/accent_cyan" />
        </FrameLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAutoDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp"
            android:text="حذف الرسالة تلقائياً بعد الاستماع إليها"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvRecordingHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="اضغط مطولاً للتحدث وتحويل الصوت لموجات"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.khader.mawjachat.ui.WaveformView
                android:id="@+id/liveWaveformView"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:background="@drawable/bg_neon_cyan" />

            <TextView
                android:id="@+id/btnRecordHold"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_record_button"
                android:gravity="center"
                android:padding="24dp"
                android:text="اضغط مطولاً\nللتحدث"
                android:textColor="#101215"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
