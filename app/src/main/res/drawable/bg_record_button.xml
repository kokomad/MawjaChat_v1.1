<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#101215" />
            <stroke android:width="6dp" android:color="#33FF8C1A" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#FF8C1A" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#D5D8DC"
                android:centerColor="#5E6268"
                android:endColor="#D5D8DC" />
            <stroke android:width="1dp" android:color="#8B9097" />
        </shape>
    </item>
</layer-list>
